---
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource-variable/martian-mono/wdth.css';
import '../styles/global.css';
import { SITE, SECTIONS, SECTION_KEYS } from '../site.config';
import { url } from '../lib/url';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  published?: Date;
  current?: string;
  // Preview image for link sharing, relative to the site root.
  image?: string;
  // Language of the page content, when it differs from the site's.
  lang?: string;
}

const {
  title,
  description = SITE.description,
  type = 'website',
  published,
  current,
  image = 'og/default.png',
  lang = SITE.lang,
} = Astro.props;
const imageUrl = new URL(url(image), Astro.site);

const pageTitle = title ? `${title} | ${SITE.title}` : `${SITE.title}: offensive security writeups and notes`;
const canonical = new URL(Astro.url.pathname, Astro.site);

const csp = [
  "default-src 'self'",
  "script-src 'self'",
  "style-src 'self' 'unsafe-inline'",
  "img-src 'self' data: https:",
  "font-src 'self'",
  "connect-src 'self'",
  "object-src 'none'",
  "base-uri 'self'",
  "form-action 'none'",
].join('; ');

const navItems = [
  ...SECTION_KEYS.map((key) => ({ key, label: SECTIONS[key].name, href: url(`${key}/`) })),
  { key: 'about', label: 'About', href: url('about/') },
];
const year = new Date().getFullYear();
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="Content-Security-Policy" content={csp} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.author} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href={url('rss.xml')} />
    <link rel="sitemap" href={url('sitemap-index.xml')} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#F2F4F1" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#10314F" media="(prefers-color-scheme: dark)" />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:title" content={title ?? SITE.title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title ?? SITE.title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={imageUrl} />
    <script is:inline src={url('js/site.js')} defer></script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="shell site-header__inner">
        <a class="wordmark" href={url('/')} aria-label={`${SITE.title} home`}>{SITE.title.toLowerCase()}</a>
        <nav class="site-nav" aria-label="Main">
          <ul>
            {
              navItems.map((item) => (
                <li>
                  <a href={item.href} aria-current={current === item.key ? 'page' : undefined}>
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </header>

    <main id="main" class="shell">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="shell site-footer__inner">
        <p>&copy; {year} {SITE.author}</p>
        <ul class="site-footer__links">
          <li><a href={url('rss.xml')}>RSS</a></li>
          <li><a href={url('tags/')}>Tags</a></li>
          {SITE.links.github && <li><a href={SITE.links.github} rel="me">GitHub</a></li>}
          {SITE.links.hackerone && <li><a href={SITE.links.hackerone} rel="me">HackerOne</a></li>}
          {SITE.links.linkedin && <li><a href={SITE.links.linkedin} rel="me">LinkedIn</a></li>}
          {SITE.links.medium && <li><a href={SITE.links.medium} rel="me">Medium</a></li>}
          {SITE.links.x && <li><a href={SITE.links.x} rel="me">X</a></li>}
          {SITE.links.email && <li><a href={`mailto:${SITE.links.email}`}>Email</a></li>}
        </ul>
      </div>
    </footer>
  </body>
</html>
