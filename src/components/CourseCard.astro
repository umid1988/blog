---
// Home page block for the free course. Content lives in site.config.ts.
import { COURSE } from '../site.config';
import { url } from '../lib/url';

const href = COURSE.path ? url(COURSE.path) : '';
---

{
  href && (
    <section class="featured course" aria-labelledby="course-title">
      <p class="featured__kicker">{COURSE.kicker}</p>
      <h2 id="course-title" class="featured__title">
        <a href={href}>{COURSE.title}</a>
      </h2>
      <p class="lede">{COURSE.description}</p>
      <dl class="record">
        {COURSE.facts.map((f) => (
          <div>
            <dt>{f.label}</dt>
            <dd>{f.value}</dd>
          </div>
        ))}
      </dl>
      <p class="course__cta">
        <a href={href}>{COURSE.cta} <span aria-hidden="true">→</span></a>
      </p>
    </section>
  )
}
